#!/usr/bin/env python3
"""Interactive wrapper around scrape_index_pipeline - prompts for site and
mode instead of requiring them as CLI args, same division of labor as
run_crawl_interactive.sh -> run_crawl.sh: no pipeline logic is duplicated
here, this only builds, shows, and confirms the equivalent command before
exec-ing the real script.
"""
import os

from archive_crawler.pipeline import registry

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))


def prompt_site():
    sites = sorted(registry.list_sites().values(), key=lambda info: info.spider_name)
    print("Known sites:")
    for i, info in enumerate(sites, start=1):
        print(f"  {i}. {info.spider_name}")
    while True:
        choice = input(f"Select a site [1-{len(sites)}]: ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(sites):
            return sites[int(choice) - 1].spider_name
        print(f"  Enter a number between 1 and {len(sites)}.")


def prompt_mode():
    print("Mode:")
    print("  1. reindex           - index the existing CSV only, no crawl")
    print("  2. crawl-and-reindex - crawl the site fresh, then do everything reindex does")
    while True:
        choice = input("Select a mode [1-2] (default: 1): ").strip() or '1'
        if choice == '1':
            return 'reindex'
        if choice == '2':
            return 'crawl-and-reindex'
        print("  Enter 1 or 2.")


def main():
    site = prompt_site()
    mode = prompt_mode()
    cmd = [os.path.join(SCRIPT_DIR, 'scrape_index_pipeline'), mode, site]

    print(f"\nCommand: {' '.join(cmd)}\n")
    confirm = input("Proceed? [y/N]: ").strip().lower()
    if confirm != 'y':
        print("Cancelled.")
        return

    os.execv(cmd[0], cmd)


if __name__ == '__main__':
    main()
