#!/usr/bin/env python3
"""Interactive wrapper around scrape_index_pipeline - prompts for site,
mode, and any relevant overrides instead of requiring them as CLI args,
same division of labor as run_crawl_interactive.sh -> run_crawl.sh: no
pipeline logic is duplicated here, this only builds, shows, and confirms
the equivalent command before exec-ing the real script.
"""
import os
import sys

try:
    # Unused directly - importing it is what hooks GNU readline into every
    # input() call below, enabling arrow-key/Home/End/Ctrl+Left/Right line
    # editing. Without this, a script's input() (unlike the interactive
    # interpreter, which imports readline itself via site.py) prints raw
    # escape sequences instead of moving the cursor. Not available on
    # Windows without pyreadline3 - degrades to plain input() there.
    import readline  # noqa: F401
except ImportError:
    pass

from archive_crawler import settings as archive_settings
from archive_crawler.pipeline import registry

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))


def prompt_site():
    sites = sorted(registry.list_sites().values(), key=lambda info: info.spider_name)
    print("Known sites:")
    for i, info in enumerate(sites, start=1):
        print(f"  {i}. {info.spider_name}")
    while True:
        choice = input(f"Select a site [1-{len(sites)}]: ").strip()
        if choice.isdigit() and 1 <= int(choice) <= len(sites):
            return sites[int(choice) - 1].spider_name
        print(f"  Enter a number between 1 and {len(sites)}.")


def prompt_mode():
    print("Mode:")
    print("  1. index            - index the existing CSV only, no crawl")
    print("  2. crawl            - run the spider only, no indexing")
    print("  3. crawl-and-index  - crawl the site fresh, then do everything index does")
    while True:
        choice = input("Select a mode [1-3] (default: 1): ").strip() or '1'
        if choice == '1':
            return 'index'
        if choice == '2':
            return 'crawl'
        if choice == '3':
            return 'crawl-and-index'
        print("  Enter 1, 2, or 3.")


def prompt_path(label, default):
    return input(f"{label} [default: {default}]: ").strip() or None


def prompt_confirm():
    # No blank-Enter default to either answer - muscle memory assumes
    # Enter means yes, so a bare Enter re-prompts instead of silently
    # cancelling (or silently proceeding).
    while True:
        choice = input("Proceed? [y/n]: ").strip().lower()
        if choice in ('y', 'yes'):
            return True
        if choice in ('n', 'no'):
            return False
        print("  Enter y or n.")


def prompt_float_range(label, lo, hi, default):
    while True:
        raw = input(f"{label} [{lo}-{hi}, default: {default}]: ").strip()
        if not raw:
            return None
        try:
            value = float(raw)
        except ValueError:
            print(f"  Enter a number between {lo} and {hi}, or leave blank.")
            continue
        if lo <= value <= hi:
            return value
        print(f"  Must be between {lo} and {hi}.")


def prompt_int_range(label, lo, hi, default):
    while True:
        raw = input(f"{label} [{lo}-{hi}, default: {default}]: ").strip()
        if not raw:
            return None
        if raw.lstrip('-').isdigit() and lo <= int(raw) <= hi:
            return int(raw)
        print(f"  Enter a whole number between {lo} and {hi}, or leave blank.")


def main():
    site = prompt_site()
    site_info = registry.resolve(site)
    mode = prompt_mode()
    cmd = [os.path.join(SCRIPT_DIR, 'scrape_index_pipeline'), mode, site]

    csv_path = site_info.csv_path
    if mode == 'index':
        override = prompt_path("CSV path to read", csv_path)
        if override:
            cmd += ['--csv', override]
            csv_path = override

    if mode in ('index', 'crawl-and-index'):
        # Same derivation _index() itself uses when --jsonl isn't passed -
        # based on whichever CSV path will actually be read (the override
        # above, if given), so the shown default matches reality even when
        # --csv changed it.
        default_jsonl = csv_path.rsplit('.', 1)[0] + '.jsonl'
        jsonl_path = prompt_path("JSONL output path", default_jsonl)
        if jsonl_path:
            cmd += ['--jsonl', jsonl_path]

    if mode in ('crawl', 'crawl-and-index'):
        download_delay = prompt_float_range(
            "Download delay (seconds)", 0.1, 2, archive_settings.DOWNLOAD_DELAY,
        )
        if download_delay is not None:
            cmd += ['--download-delay', str(download_delay)]
        concurrency = prompt_int_range(
            "Concurrent requests per domain", 1, 20, archive_settings.CONCURRENT_REQUESTS_PER_DOMAIN,
        )
        if concurrency is not None:
            cmd += ['--concurrent-requests-per-domain', str(concurrency)]

    print(f"\nCommand: {' '.join(cmd)}\n")
    if not prompt_confirm():
        print("Cancelled.")
        return

    os.execv(cmd[0], cmd)


if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        print("\nCancelled.")
        sys.exit(130)
