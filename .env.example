# Copy this file to .env (gitignored, never commit real values) and fill
# it in for your environment. Read by archive_crawler/pipeline/push.py via
# python-dotenv.
#
# boto3 (the AWS SDK) already checks real environment variables first -
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN - before
# falling back to a shared credentials file. If the server already
# exports those (an AWS Batch/Fargate task role, credentials sourced by
# `aws configure sso`, etc.), the AWS_SHARED_CREDENTIALS_FILE/AWS_PROFILE
# lines below are never even consulted - boto3 uses the real environment
# directly. They only matter as a fallback on a server/workstation with
# no AWS environment variables of its own, to point boto3 at a specific
# credentials file and profile instead.

# Path to an AWS shared credentials file, if not at the default
# ~/.aws/credentials location. Leave unset to use the default location.
AWS_SHARED_CREDENTIALS_FILE=/path/to/.aws/credentials

# Named profile within that file to use.
AWS_PROFILE=756132184927_AdministratorAccess

# Region the target S3 bucket lives in.
AWS_DEFAULT_REGION=us-east-2

# S3 bucket that `scrape_index_pipeline push`/`crawl-and-push` uploads
# each site's converted JSONL to.
NARA_S3_BUCKET=nara-crawl-data

# Optional key prefix within that bucket. Leave unset/empty to write
# <source_site>.jsonl directly at the bucket root.
NARA_S3_PREFIX=
